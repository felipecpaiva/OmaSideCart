[Unit]
Description=Android tablet as an automatic second monitor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sidecar-display watch
ExecStop=%h/.local/bin/sidecar-display down
Restart=always
RestartSec=3
Environment=WAYLAND_DISPLAY=wayland-1

[Install]
WantedBy=graphical-session.target
