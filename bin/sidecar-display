#!/usr/bin/env bash
# sidecar-display - an Android tablet as an automatic second monitor.
#
# The tablet owns its own set of desktops (WS_SET). Hyprland walks those desktops
# to the laptop when the cable goes and brings them back when it returns, windows
# and layout intact, so nothing here has to remember anything.
#
#   watch  follow the USB cable and run up/down (systemd user service)
#   up     create the output, tunnel it over adb, stream it, show it on the tablet
#   down   stop streaming and remove the output
set -uo pipefail

# Read the config first, so its values feed the defaults below.
# shellcheck source=/dev/null
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/sidecar-display/config"
[ -r "$CONFIG" ] && . "$CONFIG"

OUT=sidecar
# Settings. Override any of these in ~/.config/sidecar-display/config
SERIAL=${SIDECAR_SERIAL:-}                 # tablet USB serial, required (see README)
LAPTOP=${SIDECAR_LAPTOP:-eDP-1}            # your built-in screen, from `hyprctl monitors`
MODE=${SIDECAR_MODE:-2960x1848@60}
SCALE=${SIDECAR_SCALE:-2}
PORT=${SIDECAR_PORT:-5900}
FPS=${SIDECAR_FPS:-60}                     # see the note on frame rate in the README
VIEWER=${SIDECAR_VIEWER:-com.gaurav.avnc}  # the tablet app, restarted to force a reconnect
AUDIO=${SIDECAR_AUDIO:-1}                  # 0 leaves the tablet speakers out of it entirely
APORT=${SIDECAR_AUDIO_PORT:-5901}
ABUF=${SIDECAR_AUDIO_BUFFER_MS:-250}       # the tablet runs early without this, see the README
APLAYER=${SIDECAR_AUDIO_PLAYER:-com.kaytat.simpleprotocolplayer}
WS_SET=${SIDECAR_WS_SET:-"6 7 8 9 10"}     # desktops that belong to the tablet
LAPTOP_WS_SET=${SIDECAR_LAPTOP_WS_SET:-"1 2 3 4 5"}  # desktops pinned to the laptop
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sidecar-display"
ADB=${ADB:-adb}                            # set a full path here if adb is not on PATH

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -1)}"
mkdir -p "$STATE"

[ -n "$SERIAL" ] || { echo "sidecar-display: set SIDECAR_SERIAL (see README)" >&2; exit 2; }

# Where the kernel lists USB devices. Only the tests point this anywhere else, so they
# can take the cable out without anyone having to walk over and take the cable out.
SYSFS=${SIDECAR_SYSFS:-/sys/bus/usb/devices}

# Match the serial, not the interface or port: both change between USB sockets.
plugged() {
  local f
  for f in "$SYSFS"/*/serial; do
    [ -r "$f" ] && [ "$(cat "$f" 2>/dev/null)" = "$SERIAL" ] && return 0
  done
  return 1
}

has_out() { hyprctl monitors -j | jq -e --arg o "$OUT" 'any(.[]; .name==$o)' >/dev/null 2>&1; }
ws_monitor() { hyprctl workspaces -j | jq -r --argjson w "$1" '.[]|select(.id==$w)|.monitor'; }
ws_windows() { hyprctl workspaces -j | jq -r --argjson w "$1" '.[]|select(.id==$w)|.windows // 0'; }
tunnel_open() { "$ADB" reverse --list 2>/dev/null | grep -q "tcp:$PORT tcp:$PORT"; }
streaming() { pgrep -x wayvnc >/dev/null; }
# The tablet only has the picture while its viewer holds the VNC socket open. Nothing
# else here tells a viewer that is showing apart from one the user has closed.
viewing() { [ -n "$(ss -tnH state established "sport = :$PORT" 2>/dev/null)" ]; }
# What "up" means, read off the system rather than remembered from the last pass.
ready() { has_out && streaming && tunnel_open; }

# The tablet speakers. A null sink collects whatever the desktop sends here, and its
# monitor is served as raw PCM down a second tunnel to a player app on the tablet.
sink_up() { pactl list short sinks 2>/dev/null | awk -v o="$OUT" '$2==o{f=1} END{exit !f}'; }
serving() { pactl list short modules 2>/dev/null | grep -q "simple-protocol-tcp.*port=$APORT"; }
atunnel_open() { "$ADB" reverse --list 2>/dev/null | grep -q "tcp:$APORT tcp:$APORT"; }
# One established socket means the player is really pulling. It is also how we notice
# the app dropped, because it never tells anyone.
playing() { [ -n "$(ss -tnH state established "sport = :$APORT" 2>/dev/null)" ]; }
audio_ready() { sink_up && serving && atunnel_open && playing; }

# The highest priority output that is not ours, for handing the desktop back on unplug.
other_sink() {
  pactl -f json list sinks 2>/dev/null | jq -r --arg o "$OUT" \
    '[.[]|select(.name!=$o)|select((.ports|length==0) or ([.ports[]?|.availability!="not available"]|any))
      |{name, p:((.properties."priority.session"//"0")|tonumber)}]|sort_by(.p)|reverse|.[0].name // empty'
}

up() {
  local w
  has_out || hyprctl output create headless "$OUT" >/dev/null
  # Pin the laptop panel: Omarchy's catch-all monitor rule leaves new outputs on position=auto
  # and will reposition the laptop panel underneath us.
  hyprctl eval "hl.monitor({output=\"$LAPTOP\", position=\"0x0\"})" >/dev/null
  hyprctl eval "hl.monitor({output=\"$OUT\", mode=\"$MODE\", position=\"auto-right\", scale=$SCALE})" >/dev/null
  local n=0; until has_out || [ $n -ge 20 ]; do sleep 0.1; n=$((n+1)); done
  has_out || { echo "sidecar: output never appeared" >&2; return 1; }

  # Split the desktops between the screens. Declaring it is all the "memory"
  # needed: Hyprland walks them off when the output goes and back when it returns.
  # persistent keeps the tablet's five on show even while empty, so its bar always
  # reads the same. The laptop's five need no persistence, the bar already pads them.
  for w in $LAPTOP_WS_SET; do
    hyprctl eval "hl.workspace_rule({workspace=\"$w\", monitor=\"$LAPTOP\"})" >/dev/null
  done
  for w in $WS_SET; do
    hyprctl eval "hl.workspace_rule({workspace=\"$w\", monitor=\"$OUT\", persistent=true})" >/dev/null
  done

  # A rule only decides where a desktop is born. Anything already sitting on the
  # wrong screen has to be walked over once, or the split is only true for
  # desktops created from here on.
  for w in $LAPTOP_WS_SET; do
    [ "$(hyprctl workspaces -j | jq -r --argjson n "$w" '.[]|select(.id==$n)|.monitor')" = "$OUT" ] \
      && hyprctl dispatch "hl.dsp.workspace.move({workspace=$w, monitor=\"$LAPTOP\"})" >/dev/null
  done
  for w in $WS_SET; do
    [ "$(hyprctl workspaces -j | jq -r --argjson n "$w" '.[]|select(.id==$n)|.monitor')" = "$LAPTOP" ] \
      && hyprctl dispatch "hl.dsp.workspace.move({workspace=$w, monitor=\"$OUT\"})" >/dev/null
  done

  # VNC is TCP, so it rides the adb tunnel. No USB tethering (it does not survive a
  # replug) and no firewall hole: wayvnc listens on loopback only.
  "$ADB" reverse "tcp:$PORT" "tcp:$PORT" >/dev/null 2>&1
  tunnel_open || { echo "sidecar: adb tunnel did not open" >&2; return 1; }

  streaming || setsid wayvnc --output="$OUT" --max-fps="$FPS" --render-cursor 127.0.0.1 "$PORT" >"$STATE/wayvnc.log" 2>&1 9>&- &
  n=0; until streaming || [ $n -ge 20 ]; do sleep 0.1; n=$((n+1)); done
  streaming || { echo "sidecar: wayvnc did not start" >&2; return 1; }
  return 0
}

audio_up() {
  [ "$AUDIO" = 1 ] || return 0
  # Dress the sink like a real display output. Without device.class and an icon the
  # desktop does not treat it as a device you can pick, it is just a stray sink.
  sink_up || pactl load-module module-null-sink sink_name="$OUT" \
    sink_properties='device.description=Sidecar device.icon_name=video-display device.class=sound node.nick=Sidecar' >/dev/null 2>&1
  sink_up || { echo "sidecar: audio sink was not created" >&2; return 1; }

  "$ADB" reverse "tcp:$APORT" "tcp:$APORT" >/dev/null 2>&1
  atunnel_open || { echo "sidecar: audio tunnel did not open" >&2; return 1; }

  # Reload the server before pointing the player at it. The player abandons its old
  # socket without closing it, and each one left behind quietly fills with audio that
  # nobody is reading. Reloading is the only end of that we control.
  local m; m=$(pactl list short modules 2>/dev/null | awk '/simple-protocol-tcp/{print $1}')
  [ -n "$m" ] && pactl unload-module "$m" >/dev/null 2>&1
  pactl load-module module-simple-protocol-tcp source="$OUT.monitor" rate=48000 format=s16le \
    channels=2 record=true listen=127.0.0.1 port="$APORT" >/dev/null 2>&1
  serving || { echo "sidecar: audio server did not start" >&2; return 1; }
  return 0
}

# Tell the player to start pulling. It runs as a service, so the tablet keeps showing
# the desktop rather than the player's own window.
play() {
  [ "$AUDIO" = 1 ] || return 0
  "$ADB" shell am start-foreground-service -n "$APLAYER/.MusicService" \
    -a "$APLAYER.action.PLAY" --es ip_addr 127.0.0.1 --ei audio_port "$APORT" \
    --ei sample_rate 48000 --ez stereo true --ei buffer_ms "$ABUF" --ez retry true >/dev/null 2>&1
}

audio_down() {
  [ "$AUDIO" = 1 ] || return 0
  # Hand the desktop back to a real output before the sink goes. Unload it while it is
  # still the default and the desktop is left pointing at a device that no longer
  # exists, which is silence everywhere with nothing obviously wrong.
  local back
  if [ "$(pactl get-default-sink 2>/dev/null)" = "$OUT" ]; then
    back=$(other_sink)
    [ -n "$back" ] && pactl set-default-sink "$back" >/dev/null 2>&1
  fi
  "$ADB" shell am start-foreground-service -n "$APLAYER/.MusicService" \
    -a "$APLAYER.action.STOP" >/dev/null 2>&1
  local m
  for m in $(pactl list short modules 2>/dev/null | awk '/simple-protocol-tcp|module-null-sink/{print $1}'); do
    pactl unload-module "$m" >/dev/null 2>&1
  done
  "$ADB" reverse --remove "tcp:$APORT" >/dev/null 2>&1
  return 0
}

# Point the tablet at the stream. Kept out of up() because up() now runs on every pass,
# and the tablet may be showing something else because that is what the user wanted.
show() {
  "$ADB" shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1
  # Stop the viewer first. Handing the link to an app that is already open only raises the
  # window it has, which is the session that just died, so nothing reconnects and the tablet
  # sits on a dead screen looking like the stream is broken.
  [ -n "$VIEWER" ] && "$ADB" shell am force-stop "$VIEWER" >/dev/null 2>&1
  "$ADB" shell am start -a android.intent.action.VIEW -d "vnc://127.0.0.1:$PORT" >/dev/null 2>&1
}

down() {
  # Drop persistence first, or the tablet's empty desktops follow the windows home
  # and clutter the laptop's bar with slots that have nothing in them.
  local w
  for w in $WS_SET; do
    hyprctl eval "hl.workspace_rule({workspace=\"$w\", monitor=\"$OUT\", persistent=false})" >/dev/null
  done
  audio_down
  pkill -x wayvnc 2>/dev/null
  "$ADB" reverse --remove "tcp:$PORT" >/dev/null 2>&1
  has_out && hyprctl output remove "$OUT" >/dev/null   # Hyprland walks the desktops home
  return 0
}

watch() {
  # One watcher only. Two of them fight and leave the screen half up.
  exec 9>"$STATE/watch.lock"
  flock -n 9 || { echo "sidecar: another watcher holds the lock" >&2; exit 0; }
  # Pointing the tablet at the stream is spaced out and bounded. The viewer needs a
  # few seconds to launch and connect, so asking every pass would restart the app
  # underneath itself and never let it settle. Once it has connected even once, a
  # viewer that goes away was closed on purpose and must not be dragged back.
  # ponytail: it stops asking after giveup seconds, so a cable plugged in only to
  # charge is left alone. Raise it if a slow tablet is still waking up past that.
  local nap=2 seen=0 lastshow=0 since=0 gap=10 giveup=120 now aseen=0 lastaudio=0
  trap 'down; exit 0' TERM INT
  while :; do
    if plugged; then
      # Compare against what is true now, never against what the last pass did. A step
      # that failed because Hyprland or adb was not up yet is retried here until it
      # takes, so a start that half worked no longer waits for a physical replug. This
      # also re-asserts the tunnel, which dies whenever the adb server restarts on its
      # own while the cable never moves.
      if ready; then
        nap=2
        now=$(date +%s)
        [ "$since" = 0 ] && since=$now
        if viewing; then seen=1
        elif [ "$seen" = 0 ] && [ $((now - since)) -lt "$giveup" ] && [ $((now - lastshow)) -ge "$gap" ]; then
          show; lastshow=$now
        fi
        # Audio gets the same treatment and the same ceiling. ponytail: once it has
        # played, a drop is not chased, because the far more likely reason for silence
        # is that the desktop was pointed at another output on purpose.
        if audio_ready; then aseen=1
        elif [ "$aseen" = 0 ] && [ $((now - since)) -lt "$giveup" ] && [ $((now - lastaudio)) -ge "$gap" ]; then
          audio_up && play; lastaudio=$now
        fi
      elif up; then
        # The stream was gone, so whatever the tablet was showing died with it. That is
        # not the user closing the viewer, and the give-up clock has to start again too.
        seen=0; aseen=0; since=0; nap=2
      else
        seen=0; aseen=0; since=0
        # up said on stderr which step failed. Back off, or a machine that cannot
        # recover writes that same line into the journal every couple of seconds.
        nap=$((nap < 60 ? nap * 2 : nap))
      fi
    else
      # Not ready is not the same as nothing to tear down: a half up sidecar still
      # owns an output and a wayvnc.
      if has_out || streaming; then down; fi
      seen=0; aseen=0; lastshow=0; lastaudio=0; since=0; nap=2
    fi
    sleep "$nap"
  done
}

# The runnable check. Covers everything except the physical cable.
selfcheck() {
  local rc=0 probe; probe=$(echo "$WS_SET" | awk '{print $1}')
  up || { echo "FAIL: up"; return 1; }
  hyprctl monitors -j | jq -e --arg o "$OUT" --argjson w "${MODE%%x*}" 'any(.[]; .name==$o and .width==$w)' >/dev/null \
    && echo "PASS: $OUT is ${MODE%%x*} wide" || { echo "FAIL: $OUT wrong width"; rc=1; }
  pgrep -x wayvnc >/dev/null && echo "PASS: wayvnc is streaming" || { echo "FAIL: wayvnc not running"; rc=1; }
  ss -tlnp 2>/dev/null | grep -q "127.0.0.1:$PORT" && echo "PASS: wayvnc is loopback-only" || { echo "FAIL: wayvnc not on loopback"; rc=1; }
  "$ADB" reverse --list 2>/dev/null | grep -q "tcp:$PORT tcp:$PORT" && echo "PASS: adb tunnel is open" || { echo "FAIL: no adb tunnel"; rc=1; }

  # A window opened on a tablet desktop must be born on the tablet.
  hyprctl dispatch "hl.dsp.exec_cmd(\"[workspace $probe silent] foot -T sidecar-selfcheck\")" >/dev/null; sleep 3
  [ "$(ws_monitor "$probe")" = "$OUT" ] && [ "$(ws_windows "$probe")" -gt 0 ] \
    && echo "PASS: desktop $probe opened on the tablet" || { echo "FAIL: desktop $probe is on $(ws_monitor "$probe")"; rc=1; }
  [ "$(hyprctl activewindow -j | jq -r '.monitor // 0')" = "0" ] \
    && echo "PASS: focus stayed on the laptop" || { echo "FAIL: focus jumped to the tablet"; rc=1; }

  down; sleep 2
  [ "$(ws_monitor "$probe")" = "$LAPTOP" ] && [ "$(ws_windows "$probe")" -gt 0 ] \
    && echo "PASS: it came home on unplug, windows intact" || { echo "FAIL: on unplug it is on $(ws_monitor "$probe") with $(ws_windows "$probe") windows"; rc=1; }
  has_out && { echo "FAIL: output still there"; rc=1; } || echo "PASS: output removed"
  pgrep -x wayvnc >/dev/null && { echo "FAIL: wayvnc still running"; rc=1; } || echo "PASS: wayvnc stopped"
  # A running watcher re-asserts the tunnel every couple of seconds while the
  # tablet is plugged in, so a simulated unplug can never leave it closed. On a
  # real unplug it does close, because then the watcher sees the device is gone.
  if flock -n "$STATE/watch.lock" true 2>/dev/null; then
    "$ADB" reverse --list 2>/dev/null | grep -q "tcp:$PORT" && { echo "FAIL: tunnel left open"; rc=1; } || echo "PASS: tunnel closed"
  else
    echo "SKIP: tunnel close (a watcher is running and re-asserts it)"
  fi

  up >/dev/null; sleep 3
  [ "$(ws_monitor "$probe")" = "$OUT" ] && [ "$(ws_windows "$probe")" -gt 0 ] \
    && echo "PASS: it went back to the tablet on replug" || { echo "FAIL: on replug it is on $(ws_monitor "$probe")"; rc=1; }
  pgrep -x Hyprland >/dev/null && echo "PASS: compositor survived" || { echo "FAIL: Hyprland died"; rc=1; }

  hyprctl clients -j | jq -r '.[]|select(.class=="foot")|.pid' | xargs -r kill 2>/dev/null
  return $rc
}

case "${1:-}" in
  up) up && { audio_up && play; show; } ;;
  down) down ;;
  watch) watch ;;
  selfcheck) selfcheck ;;
  audio-toggle)
    # Flip the desktop between the tablet and whatever real output is next best, and
    # take the playing streams with it. Sound and picture reach the tablet by separate
    # paths with no clock between them, so lip sync cannot be held; this is how you get
    # the speakers for music and the laptop back for anything with faces in it.
    if [ "$(pactl get-default-sink 2>/dev/null)" = "$OUT" ]; then to=$(other_sink); else to=$OUT; fi
    [ -n "$to" ] || { echo "sidecar: no other output to switch to" >&2; exit 1; }
    pactl set-default-sink "$to" >/dev/null 2>&1
    # Move real application streams only. A filter chain's own output is a sink input
    # too, and moving that rewires the processing instead of the audio.
    pactl list sink-inputs 2>/dev/null | awk '
      /^Sink Input #/ {id = substr($3, 2)}
      /application\.name = / { a = $0; sub(/.*application\.name = "/, "", a); sub(/"$/, "", a)
        if (a != "EasyEffects") print id }' | while read -r i; do
      pactl move-sink-input "$i" "$to" >/dev/null 2>&1
    done
    if [ "$to" = "$OUT" ]; then w="the tablet"; else w=$(echo "$to" | sed 's/.*HiFi__//;s/__sink$//'); fi
    echo "sound: $w"
    # Bound to a key it runs with nobody watching the terminal, so say it on screen.
    command -v notify-send >/dev/null && notify-send -t 1500 -i audio-speakers "Sound: $w" ;;
  audio-delay)
    # The player holds three packets of ABUF each plus a hardware buffer, so the delay
    # you hear is roughly three times this number. Too low and sound runs ahead of the
    # picture, too high and it trails. Ears are the only instrument for this.
    [ -n "${2:-}" ] || { echo "usage: sidecar-display audio-delay <ms>   (now: $ABUF)" >&2; exit 2; }
    # Go through audio_up rather than straight to play, or every tweak leaves the
    # player's last socket behind filling with audio nobody reads.
    ABUF=$2; audio_up && play
    echo "buffer now ${ABUF}ms, so roughly $((ABUF * 3))ms behind. Keep it with:"
    echo "  SIDECAR_AUDIO_BUFFER_MS=$ABUF   in ~/.config/sidecar-display/config" ;;
  state)
    # One word, for the bar widget to poll cheaply.
    if ! plugged; then echo away
    elif has_out && pgrep -x wayvnc >/dev/null; then echo streaming
    else echo plugged
    fi ;;
  status)
    plugged && echo "tablet:          plugged" || echo "tablet:          unplugged"
    has_out && echo "output:          up" || echo "output:          down"
    pgrep -x wayvnc >/dev/null && echo "wayvnc:          running" || echo "wayvnc:          stopped"
    "$ADB" reverse --list 2>/dev/null | grep -q "tcp:$PORT" && echo "tunnel:          open" || echo "tunnel:          closed"
    if [ "$AUDIO" = 1 ]; then
      playing && echo "audio:           playing on the tablet" \
        || { serving && echo "audio:           served, no player attached" || echo "audio:           off"; }
      [ "$(pactl get-default-sink 2>/dev/null)" = "$OUT" ] && echo "desktop output:  the tablet" \
        || echo "desktop output:  $(pactl get-default-sink 2>/dev/null | sed 's/.*HiFi__/…/')"
    fi
    echo "tablet desktops: $WS_SET" ;;
  *) echo "usage: sidecar-display {up|down|watch|selfcheck|status|state|audio-toggle|audio-delay <ms>}" >&2; exit 2 ;;
esac
